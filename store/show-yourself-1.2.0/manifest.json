{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Show Yourself",
  "version": "1.2.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["storage", "scripting", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Show Yourself",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/AtkinsonHyperlegibleMono.ttf", "icons/icon-128.png"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["features.js", "i18n.js", "files.js", "analyzer.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
